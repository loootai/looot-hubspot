# Copy to .env and fill in. Never commit .env.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must equal one of the redirectUrls in src/app/app-hsmeta.json
HUBSPOT_REDIRECT_URI=https://YOUR-BACKEND.example.com/oauth/callback
# Public https origin of this backend, used to rebuild the URL HubSpot signed
PUBLIC_BASE_URL=https://YOUR-BACKEND.example.com
# Optional: most one lookup may spend across looot fallback providers, in USD
LOOOT_MAX_COST_USD=
# Optional: where the JSON file token store writes (local use only)
TOKEN_FILE=.hubspot-tokens.json
PORT=3000
